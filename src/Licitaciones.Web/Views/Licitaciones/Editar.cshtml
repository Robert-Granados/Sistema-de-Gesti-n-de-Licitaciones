@model Licitaciones.Web.Models.Licitaciones.EditarLicitacionViewModel

@{
    ViewData["Title"] = "Editar licitación";
}

<div class="row justify-content-center">
    <div class="col-md-7 col-lg-6">
        <h1>Editar licitación</h1>
        <p class="text-muted">
            Modifique la información de la licitación <strong>@Model.Codigo</strong>.
        </p>

        <form asp-action="Editar" asp-route-id="@Model.Id" method="post">
            <input asp-for="Id" type="hidden" />
            <input asp-for="Codigo" type="hidden" />
            <input asp-for="RowVersion" type="hidden" />

            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="mb-3">
                <label class="form-label">Código</label>
                <input value="@Model.Codigo" class="form-control" disabled />
                <div class="form-text">El código no se puede modificar.</div>
            </div>

            <div class="mb-3">
                <label asp-for="Titulo" class="form-label"></label>
                <input asp-for="Titulo"
                       class="form-control"
                       maxlength="300" />
                <span asp-validation-for="Titulo" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="FechaCierre" class="form-label"></label>
                <input asp-for="FechaCierre"
                       type="datetime-local"
                       class="form-control" />
                <div class="form-text">
                    Seleccione la fecha y hora de cierre (debe ser futura).
                </div>
                <span asp-validation-for="FechaCierre" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="PresupuestoEstimadoCrc" class="form-label"></label>
                <input asp-for="PresupuestoEstimadoCrc"
                       type="number"
                       step="0.01"
                       min="0.01"
                       class="form-control" />
                <div class="form-text">
                    Presupuesto estimado en colones costarricenses (debe ser mayor a cero y no menor al monto de una oferta existente).
                </div>
                <span asp-validation-for="PresupuestoEstimadoCrc" class="text-danger"></span>
            </div>

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary">Guardar cambios</button>
                <a asp-action="Detalle"
                   asp-route-id="@Model.Id"
                   class="btn btn-outline-secondary">Cancelar</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
