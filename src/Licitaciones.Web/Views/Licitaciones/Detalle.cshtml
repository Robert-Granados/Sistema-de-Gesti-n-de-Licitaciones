@using Licitaciones.Application.Licitaciones.Detalle
@using System.Globalization
@model LicitacionDetalleDto

@{
    ViewData["Title"] = $"Detalle — {Model.Codigo}";
    var crCulture = new CultureInfo("es-CR");
    var ahora = DateTimeOffset.UtcNow;
    var estaCerradaFuncionalmente = Model.Estado == Licitaciones.Domain.Enums.EstadoLicitacion.Publicada
        && Model.FechaCierre <= ahora;
    var puedeEliminar = Model.Estado == Licitaciones.Domain.Enums.EstadoLicitacion.Borrador
        && Model.Ofertas.TotalRegistros == 0;
    var puedeOfertar = Model.Estado == Licitaciones.Domain.Enums.EstadoLicitacion.Publicada
        && Model.FechaCierre > ahora;
}

<div class="d-flex justify-content-between align-items-start mb-4">
    <div>
        <h1>@Model.Codigo</h1>
        <p class="text-muted mb-0">@Model.Titulo</p>
    </div>
    <div class="d-flex flex-wrap gap-2">
        @if (Model.TipoCambio is not null)
        {
            <div class="btn-group"
                 role="group"
                 aria-label="Moneda de visualización"
                 data-currency-toggle
                 data-exchange-rate="@Model.TipoCambio.CrcPorUsd.ToString(CultureInfo.InvariantCulture)"
                 data-rate-date="@Model.TipoCambio.FechaVigencia.ToString("dd/MM/yyyy")">
                <button type="button" class="btn btn-outline-success active" data-currency="CRC">CRC</button>
                <button type="button" class="btn btn-outline-success" data-currency="USD">USD</button>
            </div>
        }
        @if (Model.Estado == Licitaciones.Domain.Enums.EstadoLicitacion.Borrador
            || Model.Estado == Licitaciones.Domain.Enums.EstadoLicitacion.Publicada)
        {
            <a asp-action="Editar"
               asp-route-id="@Model.Id"
               class="btn btn-primary">Editar</a>
        }

        @if (Model.Estado == Licitaciones.Domain.Enums.EstadoLicitacion.Borrador
            && Model.PresupuestoEstimadoCrc > 0
            && Model.FechaCierre > ahora)
        {
            <form asp-action="Publicar" asp-route-id="@Model.Id" method="post" class="d-inline">
                @Html.AntiForgeryToken()
                <button type="submit"
                        class="btn btn-success"
                        onclick="return confirm('¿Está seguro de publicar esta licitación?')">
                    Publicar
                </button>
            </form>
        }

        @if (Model.Estado == Licitaciones.Domain.Enums.EstadoLicitacion.Publicada
            || Model.Estado == Licitaciones.Domain.Enums.EstadoLicitacion.Borrador)
        {
            <button type="button"
                    class="btn btn-danger"
                    data-bs-toggle="modal"
                    data-bs-target="#cerrarModal">
                Cerrar
            </button>
        }

        @if (puedeEliminar)
        {
            <form asp-action="Eliminar"
                  asp-route-id="@Model.Id"
                  method="post"
                  data-confirm-delete
                  data-confirm-title="Eliminar licitación"
                  data-confirm-message="¿Confirma que desea eliminar la licitación “@Model.Codigo”? Esta acción no se puede deshacer.">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-outline-danger">Eliminar</button>
            </form>
        }

        <a asp-action="Index" class="btn btn-outline-secondary">Volver a licitaciones</a>
    </div>
</div>
@if (Model.TipoCambio is not null)
{
    <p class="small text-muted text-end mt-n2 mb-3">
        La vista USD usa el tipo de cambio local vigente desde
        <strong>@Model.TipoCambio.FechaVigencia.ToString("dd/MM/yyyy")</strong>
        (1 USD = @Model.TipoCambio.CrcPorUsd.ToString("N6", crCulture) CRC).
    </p>
}

<div class="row g-4 mb-4">
    <div class="col-md-3">
        <div class="card">
            <div class="card-body">
                <h6 class="card-title text-muted">Estado</h6>
                @if (estaCerradaFuncionalmente)
                {
                    <span class="badge bg-warning text-dark">Cerrada (vencida)</span>
                }
                else if (Model.Estado == Licitaciones.Domain.Enums.EstadoLicitacion.Publicada)
                {
                    <span class="badge bg-success">Publicada</span>
                }
                else if (Model.Estado == Licitaciones.Domain.Enums.EstadoLicitacion.Cerrada)
                {
                    <span class="badge bg-danger">Cerrada</span>
                }
                else
                {
                    <span class="badge bg-secondary">Borrador</span>
                }
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card">
            <div class="card-body">
                <h6 class="card-title text-muted">Fecha de cierre</h6>
                <p class="mb-0">@Model.FechaCierre.ToOffset(TimeSpan.FromHours(-6)).ToString("dd/MM/yyyy HH:mm") (CRT)</p>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card">
            <div class="card-body">
                <h6 class="card-title text-muted">Presupuesto estimado</h6>
                <p class="mb-0 fw-bold"
                   data-currency-amount="@Model.PresupuestoEstimadoCrc.ToString(CultureInfo.InvariantCulture)">
                    @Model.PresupuestoEstimadoCrc.ToString("C", crCulture)
                </p>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card">
            <div class="card-body">
                <h6 class="card-title text-muted">Total ofertas</h6>
                <p class="mb-0 fw-bold">@Model.Ofertas.TotalRegistros</p>
            </div>
        </div>
    </div>
</div>

@if (Model.MejorOferta is not null)
{
    var me = Model.MejorOferta;
    <div class="card mb-4 border-success">
        <div class="card-header bg-success text-white">
            <h5 class="mb-0">Mejor oferta</h5>
        </div>
        <div class="card-body">
            <div class="row g-3">
                <div class="col-md-3">
                    <h6 class="text-muted">Proveedor</h6>
                    <p class="mb-0 fw-bold">@me.NombreProveedor</p>
                </div>
                <div class="col-md-3">
                    <h6 class="text-muted">Monto</h6>
                    <p class="mb-0 fw-bold"
                       data-currency-amount="@me.MontoOfertadoCrc.ToString(CultureInfo.InvariantCulture)">
                        @me.MontoOfertadoCrc.ToString("C", crCulture)
                    </p>
                </div>
                <div class="col-md-3">
                    <h6 class="text-muted">Clasificación de ahorro</h6>
                    @switch (me.Clasificacion)
                    {
                        case ClasificacionAhorro.OfertaConveniente:
                            <span class="badge bg-success">Oferta conveniente</span>
                            <small class="d-block text-muted mt-1">≥ 10% de ahorro</small>
                            break;
                        case ClasificacionAhorro.OfertaAceptable:
                            <span class="badge bg-warning text-dark">Oferta aceptable</span>
                            <small class="d-block text-muted mt-1">&gt; 0% y &lt; 10% de ahorro</small>
                            break;
                        case ClasificacionAhorro.OfertaValidaSinAhorro:
                            <span class="badge bg-info">Oferta válida sin ahorro</span>
                            <small class="d-block text-muted mt-1">Igual al presupuesto</small>
                            break;
                    }
                </div>
                <div class="col-md-3">
                    <h6 class="text-muted">Aprobador</h6>
                    @if (me.Aprobador is not null)
                    {
                        <p class="mb-0 fw-bold">@me.Aprobador</p>
                    }
                    else
                    {
                        <p class="mb-0 text-muted">Sin nivel de aprobación definido</p>
                    }
                </div>
            </div>
            @if (Model.TipoCambio is not null)
            {
                <hr />
                <p class="mb-0 small text-muted">
                    Tipo de cambio local: 1 USD =
                    @Model.TipoCambio.CrcPorUsd.ToString("N6", crCulture) CRC ·
                    vigencia @Model.TipoCambio.FechaVigencia.ToString("dd/MM/yyyy").
                </p>
            }
        </div>
    </div>
}
else
{
    <div class="alert alert-info mb-4" role="status">
        Sin ofertas válidas.
    </div>
}

<h2 class="h4 mb-3">Ofertas registradas</h2>

@if (puedeOfertar)
{
    <div class="card mb-4 border-primary">
        <div class="card-header bg-primary text-white">
            <h5 class="mb-0">Registrar nueva oferta</h5>
        </div>
        <div class="card-body">
            <form asp-action="RegistrarOferta" asp-route-licitacionId="@Model.Id" method="post">
                @Html.AntiForgeryToken()
                <div class="row g-3 align-items-end">
                    <div class="col-md-4">
                        <label for="ProveedorId" class="form-label">Proveedor</label>
                        <select name="ProveedorId" id="ProveedorId" class="form-select" required>
                            <option value="">Seleccione un proveedor...</option>
                            @foreach (var proveedor in Model.ProveedoresDisponibles)
                            {
                                <option value="@proveedor.Id">@proveedor.Nombre</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-4">
                        <label for="MontoOfertadoCrc" class="form-label">Monto ofertado (CRC)</label>
                        <input type="number"
                               name="MontoOfertadoCrc"
                               id="MontoOfertadoCrc"
                               class="form-control"
                               step="0.01"
                               min="0.01"
                               max="@Model.PresupuestoEstimadoCrc"
                               required
                               placeholder="0.00" />
                        <div class="form-text">
                            Máximo: @Model.PresupuestoEstimadoCrc.ToString("C", crCulture).
                            Los datos se registran siempre en CRC.
                        </div>
                    </div>
                    <div class="col-md-4">
                        <input type="hidden" name="LicitacionId" value="@Model.Id" />
                        <button type="submit" class="btn btn-primary">Registrar oferta</button>
                    </div>
                </div>
            </form>
        </div>
    </div>
}

@if (Model.Ofertas.Elementos.Count == 0)
{
    <div class="alert alert-info" role="status">
        Esta licitación todavía no tiene ofertas registradas.
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped align-middle">
            <thead>
                <tr>
                    <th scope="col">Proveedor</th>
                    <th scope="col">Monto <span data-currency-label>CRC</span></th>
                    <th scope="col">Fecha de registro</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var oferta in Model.Ofertas.Elementos)
                {
                    var esMejor = Model.MejorOferta is not null
                        && Model.MejorOferta.OfertaId == oferta.Id;
                    <tr class="@(esMejor ? "table-success" : null)">
                        <td>
                            @oferta.NombreProveedor
                            @if (esMejor)
                            {
                                <span class="badge bg-success ms-1">Mejor</span>
                            }
                        </td>
                        <td data-currency-amount="@oferta.MontoOfertadoCrc.ToString(CultureInfo.InvariantCulture)">
                            @oferta.MontoOfertadoCrc.ToString("C", crCulture)
                        </td>
                        <td>@oferta.FechaRegistro.ToString("dd/MM/yyyy HH:mm")</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

<!-- Modal de cierre -->
<div class="modal fade" id="cerrarModal" tabindex="-1" aria-labelledby="cerrarModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form asp-action="Cerrar" asp-route-id="@Model.Id" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-header">
                    <h5 class="modal-title" id="cerrarModalLabel">Cerrar licitación</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                </div>
                <div class="modal-body">
                    <p>
                        Está a punto de cerrar la licitación <strong>@Model.Codigo</strong>.
                        @if (Model.Estado == Licitaciones.Domain.Enums.EstadoLicitacion.Borrador)
                        {
                            <span class="text-warning">Esta acción cancelará la licitación.</span>
                        }
                        else
                        {
                            <span>Una vez cerrada, no se podrán registrar nuevas ofertas.</span>
                        }
                    </p>
                    <div class="mb-3">
                        <label for="motivo" class="form-label">Motivo de cierre *</label>
                        <textarea name="motivo"
                                  id="motivo"
                                  class="form-control"
                                  rows="3"
                                  required
                                  placeholder="Indique el motivo del cierre..."></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-danger">Cerrar licitación</button>
                </div>
            </form>
        </div>
    </div>
</div>
