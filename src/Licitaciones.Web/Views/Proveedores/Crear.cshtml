@model Licitaciones.Web.Models.Proveedores.CrearProveedorViewModel

@{
    ViewData["Title"] = "Registrar proveedor";
}

<div class="row justify-content-center">
    <div class="col-md-7 col-lg-6">
        <h1>Registrar proveedor</h1>
        <p class="text-muted">
            Registre un proveedor para asociarlo posteriormente a sus ofertas.
        </p>

        <form asp-controller="Proveedores" asp-action="Crear" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="mb-3">
                <label asp-for="Nombre" class="form-label"></label>
                <input asp-for="Nombre"
                       class="form-control"
                       autocomplete="organization"
                       pattern="[\p{L}\p{N}\s.,\(\)]+"
                       aria-describedby="nombre-ayuda" />
                <div id="nombre-ayuda" class="form-text">
                    Se permiten letras, números, espacios, punto, coma y paréntesis.
                </div>
                <span asp-validation-for="Nombre" class="text-danger"></span>
            </div>

            <button type="submit" class="btn btn-primary">Registrar</button>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

