@model Licitaciones.Web.Models.TiposCambio.CrearTipoCambioViewModel

@{
    ViewData["Title"] = "Registrar tipo de cambio";
}

<div class="row justify-content-center">
    <div class="col-md-7 col-lg-6">
        <h1>Registrar tipo de cambio</h1>
        <p class="text-muted">
            Registre el tipo de cambio local usado para convertir montos entre CRC y USD.
        </p>

        <form asp-action="Crear" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="mb-3">
                <label asp-for="CrcPorUsd" class="form-label"></label>
                <input asp-for="CrcPorUsd"
                       type="number"
                       step="0.000001"
                       min="0.01"
                       class="form-control"
                       placeholder="500.000000" />
                <div class="form-text">
                    Cantidad de colones por un dólar estadounidense (debe ser mayor a cero).
                </div>
                <span asp-validation-for="CrcPorUsd" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="FechaVigencia" class="form-label"></label>
                <input asp-for="FechaVigencia"
                       type="date"
                       class="form-control" />
                <div class="form-text">
                    Fecha desde la cual el tipo de cambio está vigente.
                </div>
                <span asp-validation-for="FechaVigencia" class="text-danger"></span>
            </div>

            <div class="mb-3 form-check">
                <input asp-for="Activar" class="form-check-input" />
                <label asp-for="Activar" class="form-check-label"></label>
                <div class="form-text">
                    Al activarlo, el tipo de cambio vigente anterior se desactiva automáticamente.
                </div>
            </div>

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary">Registrar</button>
                <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
