@using System.Globalization
@model Licitaciones.Web.Models.Ofertas.ListarOfertasViewModel

@{
    ViewData["Title"] = "Ofertas";
    var crCulture = new CultureInfo("es-CR");
}

@if (TempData["MensajeExito"] is string mensajeExito)
{
    <div class="alert alert-success" role="alert">@mensajeExito</div>
}

@if (TempData["MensajeError"] is string mensajeError)
{
    <div class="alert alert-danger" role="alert">@mensajeError</div>
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h1>Ofertas</h1>
        <p class="text-muted mb-0">Analice la participación de los proveedores en las licitaciones.</p>
    </div>
</div>

<form method="get" asp-action="Index" class="row g-3 mb-4">
    <div class="col-md-4">
        <label for="licitacionId" class="form-label">Licitación</label>
        <select id="licitacionId" name="licitacionId" class="form-select">
            <option value="" selected="@(!Model.LicitacionId.HasValue)">Todas</option>
            @foreach (var licitacion in Model.OpcionesFiltro.Licitaciones)
            {
                <option value="@licitacion.Id" selected="@(Model.LicitacionId == licitacion.Id)">
                    @licitacion.Codigo
                </option>
            }
        </select>
    </div>
    <div class="col-md-4">
        <label for="proveedorId" class="form-label">Proveedor</label>
        <select id="proveedorId" name="proveedorId" class="form-select">
            <option value="" selected="@(!Model.ProveedorId.HasValue)">Todos</option>
            @foreach (var proveedor in Model.OpcionesFiltro.Proveedores)
            {
                <option value="@proveedor.Id" selected="@(Model.ProveedorId == proveedor.Id)">
                    @proveedor.Nombre
                </option>
            }
        </select>
    </div>
    <div class="col-md-3">
        <label for="sortBy" class="form-label">Orden</label>
        <select id="sortBy" name="sortBy" class="form-select">
            <option value="monto" selected="@(Model.SortBy == "monto")">Monto ↑</option>
            <option value="monto_desc" selected="@(Model.SortBy == "monto_desc")">Monto ↓</option>
            <option value="fecha" selected="@(Model.SortBy == "fecha")">Fecha registro ↑</option>
            <option value="fecha_desc" selected="@(Model.SortBy == "fecha_desc")">Fecha registro ↓</option>
        </select>
    </div>
    <div class="col-md-1 d-flex align-items-end">
        <button type="submit" class="btn btn-outline-primary w-100">Aplicar</button>
    </div>
</form>

@if (Model.Resultado.Elementos.Count == 0)
{
    <div class="alert alert-info" role="status">
        No se encontraron ofertas con los criterios indicados.
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped align-middle">
            <thead>
                <tr>
                    <th scope="col">Licitación</th>
                    <th scope="col">Proveedor</th>
                    <th scope="col" class="text-end">Monto (₡)</th>
                    <th scope="col">Fecha de registro</th>
                    <th scope="col"><span class="visually-hidden">Acciones</span></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var oferta in Model.Resultado.Elementos)
                {
                    <tr>
                        <td><code>@oferta.CodigoLicitacion</code></td>
                        <td>@oferta.NombreProveedor</td>
                        <td class="text-end">@oferta.MontoOfertadoCrc.ToString("N2", crCulture)</td>
                        <td>@oferta.FechaRegistro.ToOffset(TimeSpan.FromHours(-6)).ToString("dd/MM/yyyy HH:mm")</td>
                        <td class="text-end">
                            <div class="d-flex justify-content-end gap-1">
                                <a asp-controller="Licitaciones"
                                   asp-action="Detalle"
                                   asp-route-id="@oferta.LicitacionId"
                                   class="btn btn-sm btn-outline-primary">Ver licitación</a>
                                <a asp-action="Editar"
                                   asp-route-id="@oferta.Id"
                                   class="btn btn-sm btn-outline-primary">Editar</a>
                                <form asp-action="Eliminar"
                                      asp-route-id="@oferta.Id"
                                      method="post"
                                      onsubmit="return confirm('¿Confirma la eliminación de la oferta de @oferta.NombreProveedor para la licitación @oferta.CodigoLicitacion?');">
                                    <button type="submit" class="btn btn-sm btn-outline-danger">Eliminar</button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2">
    <p class="mb-0">
        Total: <strong>@Model.Resultado.TotalRegistros</strong> ·
        Página <strong>@Model.Resultado.PaginaActual</strong> de
        <strong>@Model.Resultado.TotalPaginas</strong>
    </p>

    <nav aria-label="Paginación de ofertas">
        <ul class="pagination mb-0">
            <li class="page-item @(!Model.Resultado.TienePaginaAnterior ? "disabled" : null)">
                <a class="page-link"
                   asp-action="Index"
                   asp-route-page="@(Model.Resultado.PaginaActual - 1)"
                   asp-route-pageSize="@Model.PageSize"
                   asp-route-licitacionId="@Model.LicitacionId"
                   asp-route-proveedorId="@Model.ProveedorId"
                   asp-route-sortBy="@Model.SortBy">Anterior</a>
            </li>
            <li class="page-item @(!Model.Resultado.TienePaginaSiguiente ? "disabled" : null)">
                <a class="page-link"
                   asp-action="Index"
                   asp-route-page="@(Model.Resultado.PaginaActual + 1)"
                   asp-route-pageSize="@Model.PageSize"
                   asp-route-licitacionId="@Model.LicitacionId"
                   asp-route-proveedorId="@Model.ProveedorId"
                   asp-route-sortBy="@Model.SortBy">Siguiente</a>
            </li>
        </ul>
    </nav>
</div>
