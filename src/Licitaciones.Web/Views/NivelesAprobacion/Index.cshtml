@using System.Globalization
@model IReadOnlyList<Licitaciones.Application.NivelesAprobacion.NivelAprobacionDto>

@{
    ViewData["Title"] = "Niveles de aprobación";
    var crCulture = new CultureInfo("es-CR");
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h1>Niveles de aprobación</h1>
        <p class="text-muted mb-0">
            Configure los rangos de monto y el aprobador correspondiente.
        </p>
    </div>
    <a asp-action="Crear" class="btn btn-primary">Registrar nivel</a>
</div>

@if (Model.Count == 0)
{
    <div class="alert alert-info" role="status">
        Todavía no hay niveles de aprobación registrados.
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped align-middle">
            <thead>
                <tr>
                    <th scope="col">Monto mínimo (₡)</th>
                    <th scope="col">Monto máximo (₡)</th>
                    <th scope="col">Aprobador</th>
                    <th scope="col"><span class="visually-hidden">Acciones</span></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var nivel in Model)
                {
                    <tr>
                        <td>@nivel.MontoMinimoCrc.ToString("N2", crCulture)</td>
                        <td>
                            @if (nivel.MontoMaximoCrc.HasValue)
                            {
                                @nivel.MontoMaximoCrc.Value.ToString("N2", crCulture)
                            }
                            else
                            {
                                <span class="badge bg-secondary">Sin límite</span>
                            }
                        </td>
                        <td>@nivel.Aprobador</td>
                        <td class="text-end">
                            <div class="d-flex justify-content-end gap-1">
                                <a asp-action="Editar"
                                   asp-route-id="@nivel.Id"
                                   class="btn btn-sm btn-outline-secondary">Editar</a>
                                <form asp-action="Eliminar"
                                      asp-route-id="@nivel.Id"
                                      method="post"
                                      onsubmit="return confirm('¿Confirma la eliminación del nivel para “@nivel.Aprobador”?');">
                                    <button type="submit" class="btn btn-sm btn-outline-danger">Eliminar</button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
