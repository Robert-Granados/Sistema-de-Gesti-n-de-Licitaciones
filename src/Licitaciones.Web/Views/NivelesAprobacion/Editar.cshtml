@model Licitaciones.Web.Models.NivelesAprobacion.EditarNivelAprobacionViewModel

@{
    ViewData["Title"] = "Editar nivel de aprobación";
}

<div class="row justify-content-center">
    <div class="col-md-7 col-lg-6">
        <h1>Editar nivel de aprobación</h1>
        <p class="text-muted">
            Actualice el rango y el aprobador conservando la no superposición.
        </p>

        <form asp-action="Editar" asp-route-id="@Model.Id" method="post">
            <input asp-for="Id" type="hidden" />

            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="mb-3">
                <label asp-for="MontoMinimoCrc" class="form-label"></label>
                <input asp-for="MontoMinimoCrc"
                       type="number"
                       step="0.01"
                       min="0"
                       class="form-control"
                       placeholder="0.00" />
                <span asp-validation-for="MontoMinimoCrc" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="MontoMaximoCrc" class="form-label"></label>
                <input asp-for="MontoMaximoCrc"
                       type="number"
                       step="0.01"
                       min="0"
                       class="form-control"
                       placeholder="0.00" />
                <div class="form-text">
                    Déjelo vacío para indicar un rango abierto (sin límite).
                </div>
                <span asp-validation-for="MontoMaximoCrc" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Aprobador" class="form-label"></label>
                <input asp-for="Aprobador"
                       class="form-control"
                       maxlength="200"
                       placeholder="Ejemplo: Gerencia" />
                <span asp-validation-for="Aprobador" class="text-danger"></span>
            </div>

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary">Guardar cambios</button>
                <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
